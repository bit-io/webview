extern static [c, "webview"] is
    fn webview_create(debug: i32, window: int) -> int
    fn webview_destroy(w: int) -> i32
    fn webview_run(w: int) -> i32
    fn webview_terminate(w: int) -> i32
    fn webview_dispatch(w: int, cb: int, arg: int) -> i32
    fn webview_get_window(w: int) -> int
